{
  "name": "pastewise",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.12"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3102",
    "prebuild": "node scripts/release/stamp.mjs",
    "build": "next build",
    "start": "npx serve out -l 3102",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "spike": "node scripts/spike/run.mjs",
    "lint:fix": "eslint --fix",
    "test:coverage": "vitest run --coverage",
    "e2e:live": "playwright test -c playwright.live.config.ts",
    "check:sets": "node scripts/sets/check_gold.mjs sets/bench.json",
    "lighthouse": "npx --yes @lhci/cli@0.15.1 autorun",
    "ci": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run e2e"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "next": "^16.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "happy-dom": "^21.0.4",
    "puppeteer-core": "^25.18.1",
    "serve": "^14.2.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.4"
  }
}
